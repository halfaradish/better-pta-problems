{
  "manifest_version": 3,
  "name": "更好的题目集（PTA 增强）",
  "version": "0.11.0",
  "description": "在 PTA 题目集列表页按课程分组与筛选，显示课程徽章与截止倒计时，支持截止提醒（浏览器通知 / 可选自建后端邮件）。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://images.ptausercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://pintia.cn/*", "https://www.pintia.cn/*"],
      "js": ["content/core.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "更好的题目集",
    "default_popup": "popup/popup.html"
  }
}
