# 复制为 .env 后按需修改；所有值均为占位符，切勿把真实凭据提交进仓库

# HTTP 监听端口
PORT=8787

# SQLite 数据文件路径（默认取本目录下 data.db；Docker 里指向挂载卷）
# DB_FILE=/app/data/data.db

# SMTP 发信账号（QQ 邮箱示例：smtp.qq.com:465，密码用「授权码」而非登录密码）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-auth-code
# 发件人显示地址，留空则用 SMTP_USER
MAIL_FROM=
# 发件人显示名：收件箱列表里看到的名字，默认「更好的题目集」；设为空串则跟随邮箱账号名
MAIL_FROM_NAME=更好的题目集

# 截止前多少分钟提醒，逗号分隔（默认提前 3 天和 1 天）
REMIND_BEFORE_MINUTES=4320,1440

# 调度检查间隔（秒）
CHECK_INTERVAL_SECONDS=60

# 宕机补发宽限（分钟）：触发点已过超过该时长就不再补发
GRACE_MINUTES=120

# 测试邮件冷却（秒）：防连点刷信，每个邮箱独立计时
TEST_COOLDOWN_SECONDS=60

# 邮件里时间的显示时区
DISPLAY_TZ=Asia/Shanghai

# 访问令牌：留空 = 不鉴权（建议公网部署时设置）；设置后插件服务器地址要填 ip:port/令牌
TOKEN=

# 只打印邮件不真发（调试用；未配置 SMTP_HOST 时也自动等效开启）
DRY_RUN=
